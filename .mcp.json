{
  "mcpServers": {
    "personal-task-manager": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "personal-task-mcp/mcp-server",
        "python",
        "personal-task-mcp/server.py"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  }
}
